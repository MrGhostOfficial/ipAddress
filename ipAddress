# Spinner for long downloads (generic)
spinner() {
    local pid
    sleep 5 & pid=$!
    local delay=0.12
    local spinner=('█■■■■' '■█■■■' '■■█■■' '■■■█■' '■■■■█')

    tput civis  # hide cursor
    while kill -0 "$pid" 2>/dev/null; do
        for i in "${spinner[@]}"; do
            kill -0 "$pid" 2>/dev/null || break
            printf "\r\033[K\033[1;32mDownloading Please wait...\033[1;33m [%s]\033[0m" "$i"
            sleep "$delay"
        done
    done
    wait "$pid" 2>/dev/null
    tput cnorm  # show cursor
    printf "\r\033[K\033[0;31m[\033[1;32mDone!\033[0;31m]\033[0m\n"
    echo ''
}

# Alternative progress bar
spinner2() {
    sleep 2 & pid=$!
    echo -e "IT MAY TAKE SOME TIME, BE PATIENT."
    printf "\033[0;31m["
    for _ in {1..20}; do
        printf "\033[1;32m▓"
        sleep 0.10
    done
    wait "$pid" 2>/dev/null
    printf "\033[0;31m] \033[1;32mdone\033[0;31m!\e[0m\n"
    echo ''
}

