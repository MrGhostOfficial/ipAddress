# ---------------------------
# Repository Update
# ---------------------------
repo_update() {
    clear
    reset
    source_animation 'dHRlIC0tZnJhbWUtcmF0ZSA2NjYgLWkgJFBSRUZJWC9zaGFyZS9pZ2hvc3QvZ2l0LnVwZGF0ZSAtLXJhbmRvbS1lZmZlY3QgLS1leGNsdWRlLWVmZmVjdHMgbWF0cml4'

    local repo_url="https://github.com/MrGhostOfficial/ipAddress.git"
    local target="$HOME/ipAddress"

    mkdir -p "$target"
    echo -e "${C_BLUE}Target contents removed (folder kept): ${C_RED_L}${C_RED}$target${C_RESET}"
    rm -rf "$target"/* "$target"/.[!.]* "$target"/..?* 2>/dev/null || true

    echo -e "${C_GREEN}Cloning fresh repository${C_RED_L}...${C_RESET}"
    local temp_dir
    temp_dir=$(mktemp -d)
    git clone "$repo_url" "$temp_dir"

    shopt -s dotglob
    mv "$temp_dir"/* "$target"/ 2>/dev/null || true
    rm -rf "$temp_dir"

    echo -e "${C_GREEN}✓ Success${C_RED}! ${C_CYAN}Files are now inside $target ${C_RED_L}(${C_YELLOW_L}folder preserved${C_RED_L})${C_RESET}\n"
    chmod +x ipAddress
    ls "$target"
    exit 0
}

