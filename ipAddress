# ---------------------------
# IP Changer (TOR rotation) - FIXED: no early exit on curl failure
# ---------------------------
ip_changer() {
    clear
    source_animation 'dHRlIC0tZnJhbWUtcmF0ZSA2NjYgLWkgfi9pcEFkZHJlc3MvQUdJVEZPTERFUi8ubG9nbzIgLS1yYW5kb20tZWZmZWN0IC0tZXhjbHVkZS1lZmZlY3RzIG1hdHJpeA'

    echo -e "\n${C_RED}[${C_WHITE}+${C_RED}] ${C_WHITE}Launching Tor Nodes & Proxy Server${C_RED_L}...${C_RESET}"

    # --------------------------------------------------------------
    # 1. Configuration
    # --------------------------------------------------------------
    readonly TOR_PORTS=(9050 9060 9070 9080 9090)
    readonly CTRL_PORTS=(9051 9061 9071 9081 9091)
    readonly TOR_BASE="$HOME/.tor_multi"
    readonly PRIVOXY_CONF="$HOME/.privoxy/config"
    readonly PRIVOXY_PORT=8118
    readonly PROXY_URL="http://127.0.0.1:$PRIVOXY_PORT"
    readonly API_URL="https://api64.ipify.org"

    # --------------------------------------------------------------
    # 2. Cleanup function – kills all spawned processes on exit
    # --------------------------------------------------------------
    cleanup() {
        echo -e "\n${C_YELLOW}Shutting down TOR and Privoxy processes...${C_RESET}"
        pkill -f "tor -f $TOR_BASE" 2>/dev/null || true
        pkill -f "privoxy $PRIVOXY_CONF" 2>/dev/null || true
        exit 0
    }
    trap cleanup EXIT INT TERM

    # --------------------------------------------------------------
    # 3. Check required dependencies
    # --------------------------------------------------------------
    for cmd in tor privoxy curl nc; do
        if ! command -v "$cmd" &>/dev/null; then
            echo -e "${C_RED}Error: $cmd is not installed. Please install it first.${C_RESET}"
            sleep 2
            back_menu
            return
        fi
    done

    # --------------------------------------------------------------
    # 4. Start multiple TOR instances
    # --------------------------------------------------------------
    echo -e "${C_CYAN}Starting TOR daemons...${C_RESET}"
    for i in "${!TOR_PORTS[@]}"; do
        local tor_dir="$TOR_BASE/tor$i"
        mkdir -p "$tor_dir"
        cat <<EOF > "$tor_dir/torrc"
SocksPort ${TOR_PORTS[$i]}
ControlPort ${CTRL_PORTS[$i]}
DataDirectory $tor_dir
CookieAuthentication 0
EOF
        tor -f "$tor_dir/torrc" >/dev/null 2>&1 &
        local tor_pid=$!
        echo "  TOR instance $i (PID $tor_pid) on port ${TOR_PORTS[$i]}"
        # Wait for the port to become available
        local timeout=15
        while ! nc -z 127.0.0.1 "${TOR_PORTS[$i]}" &>/dev/null; do
            sleep 0.5
            ((timeout--))
            if [[ $timeout -eq 0 ]]; then
                echo -e "${C_RED}Timeout waiting for TOR port ${TOR_PORTS[$i]}${C_RESET}"
                cleanup
                return
            fi
        done
        sleep 1
    done

    # Give TOR extra time to bootstrap
    echo -e "${C_YELLOW}Waiting 8 seconds for TOR to bootstrap...${C_RESET}"
    sleep 8

    # --------------------------------------------------------------
    # 5. Configure Privoxy
    # --------------------------------------------------------------
    echo -e "${C_CYAN}Configuring Privoxy...${C_RESET}"
    mkdir -p "$(dirname "$PRIVOXY_CONF")"
    cat <<EOF > "$PRIVOXY_CONF"
listen-address 127.0.0.1:$PRIVOXY_PORT
EOF
    for port in "${TOR_PORTS[@]}"; do
        echo "forward-socks5 / 127.0.0.1:$port ." >> "$PRIVOXY_CONF"
    done

    privoxy "$PRIVOXY_CONF" >/dev/null 2>&1 &
    local privoxy_pid=$!
    echo "  Privoxy (PID $privoxy_pid) listening on port $PRIVOXY_PORT"

    # Wait for Privoxy to be ready
    local timeout=10
    while ! nc -z 127.0.0.1 "$PRIVOXY_PORT" &>/dev/null; do
        sleep 0.5
        ((timeout--))
        if [[ $timeout -eq 0 ]]; then
            echo -e "${C_RED}Timeout waiting for Privoxy on port $PRIVOXY_PORT${C_RESET}"
            cleanup
            return
        fi
    done

    # --------------------------------------------------------------
    # 6. Ask for rotation interval
    # --------------------------------------------------------------
    echo -ne "${C_BLACK}[${C_GREEN}ッ${C_BLACK}]${C_WHITE_RED}Assign IP rotation interval in seconds (min 5)${C_RESET}${C_BLACK}:${C_RED_L}> ${C_WHITE}"
    read -r rotation_time

    while [[ ! "$rotation_time" =~ ^[0-9]+$ ]] || [[ "$rotation_time" -lt 5 ]]; do
        echo -e "${C_RED}Invalid input. Please enter a number ≥ 5.${C_RESET}"
        echo -ne "${C_BLACK}[${C_GREEN}ッ${C_BLACK}]${C_WHITE_RED}Rotation interval (seconds): ${C_RESET}${C_BLACK}:${C_RED_L}> ${C_WHITE}"
        read -r rotation_time
    done

    echo -e "${C_GREEN}Rotation interval set to $rotation_time seconds.${C_RESET}"
    echo -e "${C_YELLOW}Press 'q' and Enter to stop rotation and exit.${C_RESET}\n"

    # --------------------------------------------------------------
    # 7. Infinite IP rotation loop (keeps running)
    # --------------------------------------------------------------
    while true; do
        # Send NEWNYM signal to all TOR control ports
        for ctrl_port in "${CTRL_PORTS[@]}"; do
            echo -e "AUTHENTICATE \"\"\r\nSIGNAL NEWNYM\r\nQUIT" | nc 127.0.0.1 "$ctrl_port" >/dev/null 2>&1
        done

        # Give Tor time to build a new circuit
        sleep 2

        # Fetch new IP via Privoxy – retry once if it fails
        local new_ip=""
        local attempt=0
        while [[ $attempt -lt 2 ]]; do
            new_ip=$(curl --proxy "$PROXY_URL" -s --connect-timeout 5 "$API_URL" 2>/dev/null || echo "")
            if [[ -n "$new_ip" ]]; then
                break
            fi
            sleep 1
            ((attempt++))
        done

        if [[ -z "$new_ip" ]]; then
            echo -e "${C_RED}Failed to fetch new IP (TOR may not be ready). Retrying...${C_RESET}"
        else
            echo -e "${C_GREEN}🌐 ${C_WHITE}New IP${C_RED_L}:${C_GREEN} $new_ip ✅${C_RESET}"
            echo -e "${C_RESET}[Proxy]${C_RED_L}: ${C_WHITE}127.0.0.1 ${C_RED_L}: ${C_WHITE}$PRIVOXY_PORT 🛰️${C_RESET}"
        fi

        # Wait for the specified interval, but allow user to type 'q' to quit
        for ((i=0; i<rotation_time; i++)); do
            read -t 1 -n 1 key 2>/dev/null || true
            if [[ "$key" == "q" ]]; then
                echo -e "\n${C_YELLOW}Exit requested. Cleaning up...${C_RESET}"
                cleanup
                return
            fi
        done
    done
}

